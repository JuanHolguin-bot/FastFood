# ==============================================
# FAST_FOOD - Variables de Entorno (Plantilla)
# ==============================================
# Copia este archivo como .env.local y completa con tus credenciales reales:

# 1. Base de datos MongoDB Atlas (o MongoDB local)
# Ejemplo MongoDB Atlas: mongodb+srv://<usuario>:<password>@cluster0.abcde.mongodb.net/fast_food?retryWrites=true&w=majority
# Ejemplo Local: mongodb://127.0.0.1:27017/fast_food
MONGODB_URI=mongodb+srv://<usuario>:<password>@cluster0.abcde.mongodb.net/fast_food?retryWrites=true&w=majority

# 2. Clave secreta para firmar tokens JWT (sesiones y roles)
JWT_SECRET=tu_clave_secreta_jwt_muy_segura_aqui

# 3. Credenciales de PayPal Developer (Sandbox o Live)
# Obtén estas credenciales en https://developer.paypal.com/dashboard/applications/sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=tu_paypal_client_id_aqui
PAYPAL_CLIENT_SECRET=tu_paypal_client_secret_aqui

# 4. Configuración del Servidor y WebSockets
PORT=3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
